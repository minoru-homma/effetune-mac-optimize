<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Entitlements for a notarized, hardened-runtime build (Developer ID).
         Use with: codesign --options runtime --entitlements native/app/entitlements.plist
         The ad-hoc local build (make-release.sh) does NOT use hardened runtime,
         so it relies only on Info.plist NSMicrophoneUsageDescription + TCC. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- WKWebView JS engine under hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- We dlopen our own (non-Team-signed) DSP dylibs -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
